# Copy to .env and fill in. .env is git-ignored.
# Get a key at https://aistudio.google.com/apikey
#
# The key is read by vite.config.js on the server side and injected by the
# /api/gemini proxy. The browser code never references it, so it is NOT
# shipped in the JS bundle.
VITE_GEMINI_API_KEY=your-gemini-api-key-here
